{
  "name": "airprompt",
  "version": "0.2.0",
  "description": "Set up remote terminal access for AI agent workflows in minutes",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hatefrad/airprompt.git"
  },
  "homepage": "https://github.com/hatefrad/airprompt#readme",
  "bugs": {
    "url": "https://github.com/hatefrad/airprompt/issues"
  },
  "keywords": [
    "ai-agent",
    "cli",
    "macos",
    "ssh",
    "tailscale",
    "tmux"
  ],
  "files": [
    "bin/",
    "dist/package.json",
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "airprompt": "bin/airprompt.js"
  },
  "scripts": {
    "build": "tsc && cp package.json dist/",
    "prepack": "npm run build",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/test-package.mjs",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "execa": "^8.0.1",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
